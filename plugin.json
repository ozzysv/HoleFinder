{
    "$schema": "https://go.kicad.org/api/schemas/v1",
    "identifier": "com.github.ozzysv.holefinder",
    "name": "HoleFinder",
    "description": "Inspect and locate PCB holes by drill size",
    "runtime": {
        "type": "python",
        "min_version": "3.9"
    },
    "actions": [
        {
            "identifier": "holefinder",
            "name": "HoleFinder",
            "description": "Show and locate PCB pads and vias grouped by drill size",
            "show-button": true,
            "scopes": [
                "pcb"
            ],
            "entrypoint": "holefinder_action.py",
            "icons-light": [
                "holefinder_24.png",
                "holefinder_32.png",
                "holefinder_48.png",
                "holefinder_64.png"
            ],
            "icons-dark": [
                "holefinder_24.png",
                "holefinder_32.png",
                "holefinder_48.png",
                "holefinder_64.png"
            ]
        }
    ]
}