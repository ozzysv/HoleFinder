{
    "$schema": "https://go.kicad.org/api/schemas/v1",
    "identifier": "com.github.ozzysv.holeinspector",
    "name": "HoleInspector",
    "description": "Inspect and locate PCB holes by drill size",
    "runtime": {
        "type": "python",
        "min_version": "3.9"
    },
    "actions": [
        {
            "identifier": "holeinspector",
            "name": "HoleInspector",
            "description": "Show and locate PCB pads and vias grouped by drill size",
            "show-button": true,
            "scopes": [
                "pcb"
            ],
            "entrypoint": "holeinspector_action.py",
            "icons-light": [
                "holeinspector_24.png",
                "holeinspector_32.png",
                "holeinspector_48.png",
                "holeinspector_64.png"
            ],
            "icons-dark": [
                "holeinspector_24.png",
                "holeinspector_32.png",
                "holeinspector_48.png",
                "holeinspector_64.png"
            ]
        }
    ]
}